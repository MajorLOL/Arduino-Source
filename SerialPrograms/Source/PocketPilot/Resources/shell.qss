/*  PocketPilot: the program's own widgets
 *
 *  The top bar, the side bar, the status strip, the home page and the
 *  button that starts a program. These rules go by the widgets' names and
 *  are used with every theme, also the two classic ones. The names between @ signs are
 *  replaced by the colors of the theme in use (PocketPilot_Theme.cpp).
 */


/* ---- The shell: top bar, side bar, status strip ---- */

QWidget#ppTopBar {
    background-color: @shell@;
}
QLabel#ppWordmark {
    color: @shell_text@;
    background: transparent;
}
QLabel#ppWordmarkSecond {
    color: @shell_muted@;
    background: transparent;
}
/*  Widgets that draw themselves on the shell: a sheet that gives every
    widget a background (the classic dark look) must not paint behind them. */
QWidget#ppLogo, QWidget#ppLamp {
    background: transparent;
    border: none;
}
QLabel#ppBreadcrumb {
    color: @shell_muted@;
    background: transparent;
}
QPushButton#ppBarButton {
    background: transparent;
    color: @shell_text@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton#ppBarButton:hover {
    background-color: @shell_hover@;
}
QPushButton#ppBarButton:pressed {
    background-color: @shell_pressed@;
}
QPushButton#ppBarButton:focus {
    border-color: @shell_muted@;
}
QPushButton#ppBarButton:disabled {
    color: @shell_disabled@;
    background: transparent;
    border-color: transparent;
}

QWidget#ppSidebar {
    background-color: @shell@;
}
QWidget#ppProgramSelect {
    background: transparent;
}
QLabel#ppSidebarLabel {
    color: @shell_muted@;
    background: transparent;
}
QComboBox#ppGamePicker {
    background-color: @shell_field@;
    color: @shell_text@;
    border: 1px solid @shell_line@;
    border-radius: 6px;
    padding: 5px 8px;
}
QComboBox#ppGamePicker:hover, QComboBox#ppGamePicker:focus {
    border-color: @shell_muted@;
}
QComboBox#ppGamePicker::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}
QComboBox#ppGamePicker::down-arrow {
    image: url(@arrow_down_shell@);
    width: 12px;
    height: 12px;
}
QComboBox#ppGamePicker QAbstractItemView {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @line@;
    selection-background-color: @accent@;
    selection-color: @accent_text@;
    outline: none;
}
QLineEdit#ppSearch {
    background-color: @shell_field@;
    color: @shell_text@;
    border: 1px solid @shell_line@;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: @shell_text@;
    selection-color: @shell@;
}
QLineEdit#ppSearch:focus {
    border-color: @shell_muted@;
}
QListWidget#ppProgramList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#ppProgramList:disabled {
    background: transparent;
}

QWidget#ppStatusStrip {
    background-color: @shell_deep@;
}
QWidget#ppStatusStrip QLabel {
    color: @shell_muted@;
    background: transparent;
}
QWidget#ppStatusStrip QCheckBox {
    color: @shell_muted@;
    background: transparent;
}
QWidget#ppStatusStrip QCheckBox::indicator {
    width: 12px;
    height: 12px;
    background: transparent;
    border: 1px solid @shell_muted@;
    border-radius: 3px;
}
QWidget#ppStatusStrip QCheckBox::indicator:hover {
    border-color: @shell_text@;
}
QWidget#ppStatusStrip QCheckBox::indicator:checked {
    background-color: @shell_text@;
    border-color: @shell_text@;
    image: url(@check_shell@);
}
QLabel#ppStateText {
    color: @shell_text@;
}


/* ---- The screen ---- */

QWidget#ppScreen {
    background-color: @screen@;
}
/*  The games page scrolls without a frame around it, also where a classic
    sheet frames every scroll area. */
QScrollArea#ppHomeScroll {
    background: transparent;
    border: none;
    padding: 0px;
}
QLabel#ppHomeTitle, QLabel#ppAboutTitle {
    color: @text@;
    background: transparent;
}
QLabel#ppHomeLead, QLabel#ppMuted {
    color: @muted@;
    background: transparent;
}
QPushButton#ppBack {
    background: transparent;
    color: @muted@;
    border: none;
    padding: 2px 0px 6px 0px;
    text-align: left;
}
QPushButton#ppBack:hover, QPushButton#ppBack:focus {
    color: @text@;
}
QLineEdit#ppHomeSearch {
    background-color: @field@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: @accent@;
    selection-color: @accent_text@;
}
QLineEdit#ppHomeSearch:focus {
    border-color: @accent@;
}
QTreeWidget#ppSearchResults {
    background-color: @surface@;
    border: 1px solid @line@;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}
QTreeWidget#ppSearchResults::item {
    padding: 7px 10px;
    border-radius: 5px;
}
QTreeWidget#ppSearchResults::item:hover:enabled {
    background-color: @surface_alt@;
}
QTreeWidget#ppSearchResults::item:selected {
    background-color: @accent@;
    color: @accent_text@;
}


/* ---- The button that starts a program ---- */

QPushButton#ppPrimary {
    background-color: @accent@;
    color: @accent_text@;
    border: 1px solid @accent@;
    border-radius: 6px;
    padding: 5px 14px;
}
QPushButton#ppPrimary:hover {
    background-color: @accent_hover@;
    border-color: @accent_hover@;
}
QPushButton#ppPrimary:pressed {
    background-color: @accent_pressed@;
}
QPushButton#ppPrimary:focus {
    border-color: @text@;
}
QPushButton#ppPrimary:disabled {
    background-color: @screen@;
    color: @disabled@;
    border-color: @line@;
}


/* ---- Claude: its button in the top bar, and the panel at the right ---- */

QPushButton#ppAssistantButton {
    background: transparent;
    color: @shell_text@;
    border: 1px solid @shell_line@;
    border-radius: 14px;
    min-height: 18px;
    padding: 4px 14px 4px 34px;
}
QPushButton#ppAssistantButton:hover {
    background-color: @shell_hover@;
    border-color: @shell_muted@;
}
QPushButton#ppAssistantButton:pressed {
    background-color: @shell_pressed@;
}
QPushButton#ppAssistantButton:focus {
    border-color: @shell_text@;
}
QPushButton#ppAssistantButton[open="true"] {
    background-color: @shell_text@;
    color: @shell@;
    border-color: @shell_text@;
}

QWidget#ppAssistant {
    background-color: @surface@;
    border-left: 1px solid @line@;
}
QWidget#ppAssistantGrip {
    background-color: @surface@;
}
QWidget#ppAssistantHeader, QWidget#ppAssistantRows, QWidget#ppAssistantForm {
    background: transparent;
}
QLabel#ppAssistantTitle {
    color: @text@;
    background: transparent;
}
QLabel#ppAssistantSmall, QLabel#ppAssistantStatus, QLabel#ppToolLine {
    color: @muted@;
    background: transparent;
}
QLabel#ppToolLine[failed="true"], QLabel#ppAssistantProblem {
    color: @danger@;
    background: transparent;
}
QLabel#ppAssistantLink {
    background: transparent;
}
QScrollArea#ppAssistantScroll, QScrollArea#ppAssistantFormScroll {
    background: transparent;
    border: none;
    padding: 0px;
}

/*  Buttons of the panel: one that is only text, one of the suggestions,
    and the plain one next to the button that does the main thing. */
QPushButton#ppGhost {
    background: transparent;
    color: @muted@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 9px;
}
QPushButton#ppGhost:hover {
    background-color: @surface_alt@;
    color: @text@;
    border-color: transparent;
}
QPushButton#ppGhost:pressed {
    background-color: @button_pressed@;
}
QPushButton#ppGhost:focus {
    border-color: @line@;
}
QPushButton#ppGhost:disabled {
    background: transparent;
    color: @disabled@;
    border-color: transparent;
}
QPushButton#ppSuggestion {
    background: transparent;
    color: @text@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
}
QPushButton#ppSuggestion:hover, QPushButton#ppSuggestion:focus {
    background-color: @surface_alt@;
    border-color: @accent@;
}
QPushButton#ppSecondary {
    background-color: @button@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: 6px;
    padding: 5px 12px;
}
QPushButton#ppSecondary:hover {
    background-color: @button_hover@;
    border-color: @muted@;
}
QPushButton#ppSecondary:pressed {
    background-color: @button_pressed@;
}
QPushButton#ppSecondary:focus {
    border-color: @accent@;
}

/*  The conversation: what the user wrote, what Claude answered, and the
    boxes that ask or tell something. */
QFrame#ppUserBubble {
    background-color: @surface_alt@;
    border: none;
    border-radius: 12px;
    border-bottom-right-radius: 3px;
}
QTextBrowser#ppAssistantText {
    background: transparent;
    color: @text@;
    border: none;
    padding: 0px;
    selection-background-color: @accent@;
    selection-color: @accent_text@;
}
QFrame#ppCard {
    background-color: @screen@;
    border: 1px solid @line@;
    border-radius: 10px;
}
QFrame#ppCard[kind="ask"] {
    border-color: @accent@;
}
QFrame#ppCard[kind="problem"] {
    border-color: @danger@;
}
QFrame#ppCard[kind="done"] {
    border-color: @ok@;
}
QLabel#ppCardTitle {
    color: @text@;
    background: transparent;
}
QLabel#ppCardText {
    color: @muted@;
    background: transparent;
}

/*  The box to write in, the fields of the settings, the model. */
QPlainTextEdit#ppAssistantInput {
    background-color: @field@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: 10px;
    padding: 6px 8px;
    selection-background-color: @accent@;
    selection-color: @accent_text@;
}
QPlainTextEdit#ppAssistantInput:focus {
    border-color: @accent@;
}
QLineEdit#ppAssistantField {
    background-color: @field@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: 6px;
    padding: 6px 9px;
    selection-background-color: @accent@;
    selection-color: @accent_text@;
}
QLineEdit#ppAssistantField:focus {
    border-color: @accent@;
}
QComboBox#ppAssistantModel {
    background: transparent;
    color: @muted@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 22px 3px 6px;
}
QComboBox#ppAssistantModel:hover, QComboBox#ppAssistantModel:focus {
    color: @text@;
    border-color: @line@;
}
QComboBox#ppAssistantModel:disabled {
    background: transparent;
    color: @disabled@;
    border-color: transparent;
}
QComboBox#ppAssistantModel::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
}
QComboBox#ppAssistantModel::down-arrow {
    image: url(@arrow_down@);
    width: 10px;
    height: 10px;
}
QPlainTextEdit#ppAssistantDiff {
    background-color: @field@;
    color: @muted@;
    border: 1px solid @line@;
    border-radius: 6px;
}
