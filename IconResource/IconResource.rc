IDI_ICON1 ICON "claudegg.ico"

//  What Windows shows for the program (Task Manager, the file's properties,
//  the firewall's questions). Without it only the file name ClaudeGG.exe is
//  shown. No includes: the numbers are those of winver.h, so that every
//  resource compiler can read this (VOS_NT_WINDOWS32, VFT_APP).
1 VERSIONINFO
 FILEVERSION 0,72,1,0
 PRODUCTVERSION 0,72,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Claude GG"
            VALUE "FileVersion", "0.72.1"
            VALUE "InternalName", "ClaudeGG"
            VALUE "LegalCopyright", "MIT license. Based on Pokemon Automation, Copyright (c) 2021 Alexander J. Yee and its contributors."
            VALUE "OriginalFilename", "ClaudeGG.exe"
            VALUE "ProductName", "Claude GG"
            VALUE "ProductVersion", "0.72.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
